  "metric-definitions": "<h2 class=\"\" data-ja=\"広がりと、分配先を分けて見る\" data-zh=\"分别看覆盖范围与分配位置\">広がりと、分配先を分けて見る</h2><div class=\"metric-columns\"><div><h3 class=\"\" data-ja=\"文字領域の視線被覆率\" data-zh=\"文字区域视线覆盖率\">文字領域の視線被覆率</h3><div class=\"coverage-demo\" aria-label=\"Schematic coverage, not measured data\"><i class=\"filled\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"filled\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"filled\"></i></div><p class=\"sub\" data-ja=\"文字領域のうち、熱図が覆う範囲\" data-zh=\"热图覆盖文字区域的范围\">文字領域のうち、熱図が覆う範囲</p></div><div><h3 class=\"\" data-ja=\"AOIの熱強度の割合\" data-zh=\"AOI热强度占比\">AOIの熱強度の割合</h3><div class=\"share-equation\"><span class=\"\" data-ja=\"領域内の熱強度\" data-zh=\"区域内热强度\">領域内の熱強度</span><span class=\"\" data-ja=\"サイン全体の熱強度\" data-zh=\"标识整体热强度\">サイン全体の熱強度</span></div><p class=\"sub\" data-ja=\"図は指標の説明用\" data-zh=\"图为指标示意\">図は指標の説明用</p></div></div><div class=\"metric-end\"><span class=\"metric-time\">10 s</span><p class=\"sub\" data-ja=\"理解率・正確な注視時間ではない\" data-zh=\"不是理解率或准确注视时长\">理解率・正確な注視時間ではない</p></div>",
