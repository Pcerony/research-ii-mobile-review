{
  "coordinate-map": "<h2 class=\"\" data-ja=\"視線を推定し、紙面に合わせる\" data-zh=\"估计视线，再对应到纸面\">視線を推定し、紙面に合わせる</h2><div class=\"map-body\"><div class=\"estimate-rail\"><div><h3 class=\"\" data-ja=\"視線の推定\" data-zh=\"视线估计\">視線の推定</h3><small>Web camera / WebGazer.js</small></div><div><h3 class=\"\" data-ja=\"9点校正\" data-zh=\"九点校准\">9点校正</h3><div class=\"dots\"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div></div><div class=\"map-arrow\">→</div><div><div class=\"mapped-paper\"><i></i><i></i><i></i><i></i><div class=\"region\">A</div><div class=\"region relevance\">R</div><div class=\"region\">S</div></div><p class=\"sub\" data-ja=\"四隅を指定 → 透視変換 → 領域別に集計\" data-zh=\"指定四角 → 透视变换 → 按区域汇总\">四隅を指定 → 透視変換 → 領域別に集計</p></div></div><div class=\"map-foot\"><p class=\"sub\" data-ja=\"9点校正：視線推定の調整\" data-zh=\"九点校准：调整视线估计\">9点校正：視線推定の調整</p><p class=\"sub\" data-ja=\"四隅：紙面の位置対応\" data-zh=\"四角：确定纸面对应\">四隅：紙面の位置対応</p></div>",
  "operating-panorama": "<h2 class=\"\" data-ja=\"参加者は紙面を見る\" data-zh=\"参与者观看纸面\">参加者は紙面を見る</h2><figure><img src=\"assets/four-step-workflow.png\" alt=\"姿勢確認、校正、サイン提示、解析の操作記録\"></figure><div class=\"operating-sequence\"><div><b>01</b><h3 class=\"\" data-ja=\"姿勢を決める\" data-zh=\"确定姿势\">姿勢を決める</h3></div><div><b>02</b><h3 class=\"\" data-ja=\"9点校正\" data-zh=\"九点校准\">9点校正</h3></div><div><b>03</b><h3 class=\"\" data-ja=\"サインを見る\" data-zh=\"观看标识\">サインを見る</h3></div><div><b>04</b><h3 class=\"\" data-ja=\"分布を集計\" data-zh=\"汇总分布\">分布を集計</h3></div></div><p class=\"sub\" data-ja=\"姿勢を大きく変えない条件 / 写真は操作説明用\" data-zh=\"以姿势不大幅变化为前提 / 照片仅用于操作说明\">姿勢を大きく変えない条件 / 写真は操作説明用</p>",
  "heatmap-explorer": "<div class=\"preview-head\"><h2 class=\"\" data-ja=\"9名の熱図を、一人ずつ見る\" data-zh=\"逐人查看9人的热图\">9名の熱図を、一人ずつ見る</h2><span class=\"eyebrow\" data-heatmap-current>P01</span></div><div class=\"heatmap-stage-v5\"><figure class=\"heatmap-pane\"><figcaption><span class=\"\" data-ja=\"従来版\" data-zh=\"传统版\">従来版</span><span>CONTROL</span></figcaption><div class=\"heatmap-screen\"><img data-preview-control src=\"assets/heatmaps/P01-control.png\" alt=\"P01 control heatmap\"></div></figure><nav class=\"heatmap-pickers\" aria-label=\"Participant\"><button type=\"button\" data-heatmap-pick=\"0\" aria-pressed=\"true\" title=\"P01\">P01</button><button type=\"button\" data-heatmap-pick=\"1\" aria-pressed=\"false\" title=\"P02\">P02</button><button type=\"button\" data-heatmap-pick=\"2\" aria-pressed=\"false\" title=\"P03\">P03</button><button type=\"button\" data-heatmap-pick=\"3\" aria-pressed=\"false\" title=\"P04\">P04</button><button type=\"button\" data-heatmap-pick=\"4\" aria-pressed=\"false\" title=\"P05\">P05</button><button type=\"button\" data-heatmap-pick=\"5\" aria-pressed=\"false\" title=\"P06\">P06</button><button type=\"button\" data-heatmap-pick=\"6\" aria-pressed=\"false\" title=\"P07\">P07</button><button type=\"button\" data-heatmap-pick=\"7\" aria-pressed=\"false\" title=\"P08\">P08</button><button type=\"button\" data-heatmap-pick=\"8\" aria-pressed=\"false\" title=\"P09\">P09</button></nav><figure class=\"heatmap-pane\"><figcaption><span class=\"\" data-ja=\"改良版\" data-zh=\"改良版\">改良版</span><span>INTERVENTION</span></figcaption><div class=\"heatmap-screen\"><img data-preview-intervention src=\"assets/heatmaps/P01-intervention.png\" alt=\"P01 intervention heatmap\"></div></figure></div><div class=\"preview-boundary\"><p class=\"sub\" data-ja=\"出力例・記録全体 / 次の前10秒集計とは別\" data-zh=\"输出示例・完整记录 / 与后续前10秒统计分开\">出力例・記録全体 / 次の前10秒集計とは別</p><p class=\"sub\" data-ja=\"植物・版面の違いを含む / 定量結果との対応は未確認\" data-zh=\"包含植物・版面差异 / 与定量结果的对应尚未确认\">植物・版面の違いを含む / 定量結果との対応は未確認